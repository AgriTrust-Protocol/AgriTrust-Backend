{
  "name": "agritrust-backend",
  "version": "1.0.0",
  "description": "API for AgriTrust Protocol",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node index.js",
    "preflight": "npx ts-node src/cli/preflight_command.ts",
    "test": "npx vitest run",
    "test:coverage": "npx vitest run --coverage",
    "test:contract": "npx ts-node scripts/run-openapi-contract-tests.ts",
    "test:lock": "npx ts-node tests/integration/silo_lock_test.ts",
    "test:unit": "npx ts-node tests/unit/sensors.test.ts",
    "migrate": "npx ts-node src/database/migrate.ts",
    "import:parcels": "npx ts-node src/cli/import_parcels.ts",
    "performance:check": "npx ts-node scripts/check-performance-regression.ts",
    "benchmark:timeseries": "npx ts-node scripts/benchmark-time-series.ts",
    "security:deps": "npx ts-node scripts/dependency-vulnerability-scan.ts",
    "lint": "eslint \"{src,tests,scripts}/**/*.{ts,js}\" index.js",
    "lint:fix": "eslint \"{src,tests,scripts}/**/*.{ts,js}\" index.js --fix",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,js,json,md}\" index.js package.json",
    "prepare": "husky install"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.4.0",
    "@grpc/grpc-js": "^1.14.4",
    "@noble/curves": "^2.2.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.55.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "1.29.0",
    "@opentelemetry/sdk-node": "0.55.0",
    "@opentelemetry/sdk-trace-base": "1.29.0",
    "@opentelemetry/sdk-trace-node": "1.29.0",
    "@opentelemetry/semantic-conventions": "1.27.0",
    "@stellar/stellar-sdk": "^16.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "openapi-types": "^12.1.3",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^4.17.27",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.9.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.1",
    "vitest": "^2.1.9"
  }
}
