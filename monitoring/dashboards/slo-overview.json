{
  "title": "AgriTrust SLO Overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"type":"stat","title":"Availability (30d)","targets":[{"expr":"1 - (sum(increase(http_requests_total{status_code=~\"5..\"}[30d])) / sum(increase(http_requests_total[30d])))"}]},
    {"type":"timeseries","title":"Availability Burn Rate","targets":[{"legendFormat":"5m","expr":"agritrust:http_error_ratio:5m / 0.0001"},{"legendFormat":"1h","expr":"agritrust:http_error_ratio:1h / 0.0001"},{"legendFormat":"6h","expr":"agritrust:http_error_ratio:6h / 0.0001"},{"legendFormat":"24h","expr":"agritrust:http_error_ratio:24h / 0.0001"}]},
    {"type":"timeseries","title":"Critical Path P99 Latency","targets":[{"expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))"}]},
    {"type":"timeseries","title":"HTTP Error Ratio","targets":[{"expr":"sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))"}]}
  ]
}
