{
  "title": "Secret Rotation",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Rotation failures (5m)",
      "targets": [{ "expr": "sum(increase(secret_rotation_attempts_total{result=\"failure\"}[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "Rotation duration P99",
      "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(secret_rotation_duration_seconds_bucket[5m])) by (le, target, type))" }]
    },
    {
      "type": "timeseries",
      "title": "Rotation staleness",
      "targets": [{ "expr": "secret_rotation_staleness_seconds" }]
    }
  ]
}
