# AgriTrust Backend local development defaults
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by local database-backed services.
DATABASE_URL=postgres://agritrust:agritrust@localhost:5432/agritrust

# Redis connection string used by cache, queues, and rate limiting modules.
REDIS_URL=redis://localhost:6379

# Stellar/Soroban RPC endpoint for local or testnet blockchain workflows.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# OpenTelemetry endpoint. Leave empty to disable local OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=
